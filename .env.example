# AI Employee Onboarding Automation — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
#
# Most secrets for this project live INSIDE n8n as credentials or n8n env vars.
# The variables below are reference values and any you need locally.

# ── Anthropic / Claude ───────────────────────────────────────────────────────
# Set this INSIDE n8n: Settings → Variables → ANTHROPIC_API_KEY
# For self-hosted n8n, add to your n8n .env or docker-compose.yml instead.
ANTHROPIC_API_KEY=

# ── Google Sheets ────────────────────────────────────────────────────────────
# Reference only — this ID is hardcoded in the n8n workflow node.
# Credential (OAuth2) is configured in n8n: Settings → Credentials → "Google Sheets account"
GOOGLE_SHEET_ID=1y2yofiiTOGhXhb47Hft4SuxaeA6N9_8RCjQ_jAQc50E

# ── Gmail ────────────────────────────────────────────────────────────────────
# Reference only — sending address is hardcoded in the n8n workflow nodes.
# Credential (OAuth2) is configured in n8n: Settings → Credentials → "Gmail account"
GMAIL_SENDER=therealaustinkyle@gmail.com

# ── n8n ──────────────────────────────────────────────────────────────────────
# Set this after activating the workflow in n8n — the form URL is displayed there.
N8N_FORM_URL=

# ── Misc ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
